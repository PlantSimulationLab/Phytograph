<?xml version="1.0"?>

<!--
  Single synthetic scan of a 1x1x1 m box holding BOTH randomly-oriented
  leaf patches (spherical leaf angles, G=0.5) and vertical wooden tubes
  (all-vertical branch axes). Used to test the leaf/wood split of the
  LAD inversion. Returns are labelled by distance to the known tube
  axes, so the wood_class column is exact, not a classifier output.

  True one-sided LEAF area   2.2500 m^2  -> LAD 2.2500 m^2/m^3
  True total WOOD surface    0.7787 m^2  -> WAD 0.7787 m^2/m^3
  wood share of PROJECTED area 0.1475
  wood share of RETURNS        0.2555
  The return share estimates the EXTINCTION ratio, which for well-mixed
  media equals the projected-area share above. Here it does not: the
  wood is 7 solid full-height tubes among diffuse leaves, i.e. the
  maximally SEGREGATED case, so each tube saturates its own footprint
  and takes nearly every return there. This fixture is deliberately
  the stress case, not a measure of the method accuracy; a mixed
  canopy recovers both areas to well under 1%.
  Generated by generate_lad_woodcube.py (1400x2800).
-->

<helios>

<scan>
  <filename> woodcube.xyz </filename>
  <ASCII_format> x y z is_miss wood_class </ASCII_format>
  <origin> -5.000000 0.000000 0.500000 </origin>
  <size> 1400 2800 </size>
</scan>

</helios>
